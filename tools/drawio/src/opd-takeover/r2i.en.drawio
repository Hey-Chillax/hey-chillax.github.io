=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="707.96" y="143.50" width="17.00" height="17.00" as="geometry"/></mxCell><mxCell id="e62" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8F98A6;strokeWidth=1.3;endArrow=block;endFill=1;endSize=5;startArrow=none;startFill=1;startSize=5;dashed=1;dashPattern=3 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="539.92" y="196.00" as="sourcePoint"/><mxPoint x="571.92" y="108.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t63" value="“… so the answer is 47.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="244.12" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t64" value="“… so the answer is 52.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="565.20" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t65" value="“Wait, let me check step 2 …”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="387.25" y="213.19" width="190.64" height="17.62" as="geometry"/></mxCell><mxCell id="t66" value="“### Final Answer: 52”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="698.62" y="213.19" width="154.70" height="17.62" as="geometry"/></mxCell><mxCell id="t67" value="Verifying a draft already gives the&lt;br&gt;teacher’s next-token distribution,&lt;br&gt;so checking for a takeover is free." style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24.00" y="229.60" width="198.99" height="48.80" as="geometry"/></mxCell><mxCell id="t68" value="Each takeover writes up to 3 paragraphs (256 tokens), then hands back; the answer ends after the 2nd takeover." style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="234.00" y="267.50" width="638.42" height="17.00" as="geometry"/></mxCell><mxCell id="b69" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#FBF9FE;strokeColor=#8F76C2;strokeWidth=1.3;fontFamily=Comic Sans MS;fontSize=13;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="6.00" y="308.00" width="548.00" height="242.00" as="geometry"/></mxCell><mxCell id="t70" value="When Does the Teacher Take Over?" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=14;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="318.25" width="255.32" height="19.50" as="geometry"/></mxCell><mxCell id="g71" value="1" style="ellipse;html=1;fillColor=#8F76C2;strokeColor=none;fontFamily=Comic Sans MS;fontSize=11;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="25.50" y="349.50" width="17.00" height="17.00" as="geometry"/></mxCell><mxCell id="t72" value="Reflection Trigger" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=13.5;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48.00" y="348.56" width="123.43" height="18.88" as="geometry"/></mxCell><mxCell id="t73" value="Teacher" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#3B7631;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" v