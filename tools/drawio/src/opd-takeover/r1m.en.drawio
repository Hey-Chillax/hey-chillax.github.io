=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="657.50" y="143.50" width="17.00" height="17.00" as="geometry"/></mxCell><mxCell id="e62" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8F98A6;strokeWidth=1.3;endArrow=block;endFill=1;endSize=5;startArrow=none;startFill=1;startSize=5;dashed=1;dashPattern=3 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="512.00" y="196.00" as="sourcePoint"/><mxPoint x="534.00" y="108.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t63" value="“… so the answer is 47.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="237.51" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t64" value="“… so the answer is 52.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="523.51" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t65" value="“Wait, let me check step 2 …”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="362.68" y="213.19" width="190.64" height="17.62" as="geometry"/></mxCell><mxCell id="t66" value="“### Final Answer: 52”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675.00" y="213.19" width="154.70" height="17.62" as="geometry"/></mxCell><mxCell id="t67" value="Verifying a draft already gives the&lt;br&gt;teacher’s next-token distribution,&lt;br&gt;so checking for a takeover is free." style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24.00" y="229.60" width="198.99" height="48.80" as="geometry"/></mxCell><mxCell id="t68" value="Each takeover writes up to 3 paragraphs (256 tokens), then hands back; the answer ends after the 2nd takeover." style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="232.00" y="267.50" width="638.42" height="17.00" as="geometry"/></mxCell><mxCell id="b69" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#FBF9FE;strokeColor=#8F76C2;strokeWidth=1.3;fontFamily=Comic Sans MS;fontSize=13;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="6.00" y="308.00" width="548.00" height="242.00" as="geometry"/></mxCell><mxCell id="t70" value="When Does the Teacher Take Over?" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=14;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="318.25" width="255.32" height="19.50" as="geometry"/></mxCell><mxCell id="g71" value="1" style="ellipse;html=1;fillColor=#8F76C2;strokeColor=none;fontFamily=Comic Sans MS;fontSize=11;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="25.50" y="353.50" width="17.00" height="17.00" as="geometry"/></mxCell><mxCell id="t72" value="Reflection Trigger" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=13.5;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48.00" y="352.56" width="123.43" height="18.88" as="geometry"/></mxCell><mxCell id="t73" value="Teacher’s top-1" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26.00" y="383.19" width="94.29" height="17.62" as="geometry"/></mxCell><mxCell id="t74" value="Student’s top-5" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26.00" y="413.19" width="95.74" height="17.62" as="geometry"/></mxCell><mxCell id="b75" value="Wait" style="rounded=1;arcSize=5;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#B8E3AD;strokeColor=#6AAE5C;strokeWidth=1;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="129.74" y="382.00" width="41.33" height="20.00" as="geometry"/></mxCell><mxCell id="t76" value="is one of 45 reflection words" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="179.07" y="383.19" width="173.39" height="17.62" as="geometry"/></mxCell><mxCell id="b77" value="So" style="rounded=1;arcSize=5;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#DDEEFB;strokeColor=#5B9BD5;strokeWidth=1;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="129.74" y="412.00" width="27.24" height="20.00" as="geometry"/></mxCell><mxCell id="b78" value="Then" style="rounded=1;arcSize=5;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#DDEEFB;strokeColor=#5B9BD5;strokeWidth=1;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="160.98" y="412.00" width="41.11" height="20.00" as="geometry"/></mxCell><mxCell id="b79" value="We" style="rounded=1;arcSize=5;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#DDEEFB;strokeColor=#5B9BD5;strokeWid