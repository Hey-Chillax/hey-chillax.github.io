Point"/></mxGeometry></mxCell><mxCell id="g62" value="2" style="ellipse;html=1;fillColor=#8F76C2;strokeColor=none;fontFamily=Comic Sans MS;fontSize=11;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="657.50" y="143.50" width="17.00" height="17.00" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8F98A6;strokeWidth=1.3;endArrow=block;endFill=1;endSize=5;startArrow=none;startFill=1;startSize=5;dashed=1;dashPattern=3 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="512.00" y="196.00" as="sourcePoint"/><mxPoint x="534.00" y="108.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t64" value="“… so the answer is 47.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="237.51" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t65" value="“… so the answer is 52.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="523.51" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t66" value="“Wait, let me check step 2 …”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="362.68" y="213.19" width="190.64" height="17.62" as="geometry"/></mxCell><mxCell id="t67" value="“### Final Answer: 52”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675.00" y="213.19" width="154.70" height="17.62" as="geometry"/></mxCell><mxCell id="b68" value="" style="rounded=1;arcSize=8;absoluteArcSize=