nts"><mxPoint x="592.66" y="119.70"/></Array></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#6AAE5C;strokeWidth=1.6;endArrow=none;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648.84" y="117.00" as="sourcePoint"/><mxPoint x="655.86" y="114.00" as="targetPoint"/><Array as="points"><mxPoint x="651.42" y="119.70"/></Array></mxGeometry></mxCell><mxCell id="t68" value="“… so the answer is 47.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="246.55" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t69" value="“… so the answer is 52.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="567.96" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t70" value="“Wait, let me check step 2 …”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="389.52" y="213.19" width="190.64" height="17.62" as="geometry"/></mxCell><mxCell id="t71" value="“###" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708.58" y="213.19" width="41.03" height="17.62" as="geometry"/></mxCell><mxCell id="b72" value="" style="rounded=1;arcSize=2.5;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#6AAE5C;strokeColor=none;strokeWidth=0;fontFamily=Comic Sans MS;fontSize=13;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeome