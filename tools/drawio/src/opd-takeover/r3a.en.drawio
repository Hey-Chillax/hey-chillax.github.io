elative="1" as="geometry"><mxPoint x="700.46" y="108.00" as="sourcePoint"/><mxPoint x="732.46" y="196.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t62" value="concluding" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5B448C;align=right;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="645.95" y="143.50" width="61.51" height="17.00" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8F98A6;strokeWidth=1.3;endArrow=block;endFill=1;endSize=5;startArrow=none;startFill=1;startSize=5;dashed=1;dashPattern=3 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="539.92" y="196.00" as="sourcePoint"/><mxPoint x="571.92" y="108.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t64" value="“… so the answer is 47.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="244.12" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t65" value="“… so the answer is 52.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="565.20" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t66" value="“Wait, let me check step 2 …”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="387.25" y="213.19" width="190.64" height="17.62" as="geometry"/></mxCell><mxCell id="t67" value="“###" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="691.33" y="213.19" width="41.03" height="17.62" as="geometry"/></mxCell><mxCell id="b68" value="" style="rounded=1;arcSize=2.5;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#6AAE5C;strokeColor=none;strokeWidth=0;fontFamily=Comic Sans MS;fontSize=13;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="734.86" y="216.50" width="11.00" height="11.00" as="geometry"/></mxCell><mxCell id="e69" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#FFFFFF;strokeWidth=1.5;endArrow=none;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="736.73" y="222.33" as="sourcePoint"/><mxPoint x="744.45" y="219.03" as="targetPoint"/><Array as="points"><mxPoint x="739.57" y="225.30"/></Array></mxGeometry></mxCell><mxCell id="t70" value="Final Answer: 52”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="748.36" y="213.19" width="112.26" height="17.62" as="geometry"/></mxCell><mxCell id="t71" value="Verifying a draft already gives the&lt;br&gt;teacher’s next-token distribution,&lt;br&gt;so checking for a takeover is free." style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="24.00" y="229.60" width="198.99" height="48.80" as="geometry"/></mxCell><mxCell id="t72" value="Each takeover writes up to 3 paragraphs (256 tokens), then hands back; the answer ends after the 2nd takeover." style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="234.00" y="267.50" width="638.42" height="17.00" as="geometry"/></mxCell><mxCell id="b73" value="" style="rounded=1;arcSize=10;absolute