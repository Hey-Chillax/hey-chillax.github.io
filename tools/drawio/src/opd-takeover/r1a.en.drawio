ry"><mxPoint x="655.00" y="108.00" as="sourcePoint"/><mxPoint x="677.00" y="196.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="g62" value="2" style="ellipse;html=1;fillColor=#8F76C2;strokeColor=none;fontFamily=Comic Sans MS;fontSize=11;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="657.50" y="143.50" width="17.00" height="17.00" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=none;html=1;rounded=1;strokeColor=#8F98A6;strokeWidth=1.3;endArrow=block;endFill=1;endSize=5;startArrow=none;startFill=1;startSize=5;dashed=1;dashPattern=3 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="512.00" y="196.00" as="sourcePoint"/><mxPoint x="534.00" y="108.00" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t64" value="“… so the answer is 47.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="237.51" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t65" value="“… so the answer is 52.”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="523.51" y="74.19" width="141.97" height="17.62" as="geometry"/></mxCell><mxCell id="t66" value="“Wait, let me check step 2 …”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="362.68" y="213.19" width="190.64" height="17.62" as="geometry"/></mxCell><mxCell id="t67" value="“### Final Answer: 52”" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#3B7631;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675.00" y="213.19" width="154.70" height="17.62" as="geometry"/></mxCell><mxCell id="e68" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#8F98A6;strokeWidth=1;endArrow=none;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="401.00" y="234.00" as="sourcePoint"/><mxPoint x="515.00" y="234.00" as="targetPoint"/><Array as="points"><mxPoint x="401.00" y="238.00"/><mxPoint x="515.00" y="238.00"/></Array></mxGeometry></mxCell><mxCell id="t69" value="Up to 3 paragraphs (256 tokens), then hand back" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="318.93" y="242.50" width="278.15" height="17.00" as="geometry"/></mxCell><mxCell id="t70" value="At most 2 takeovers; the answer ends after the second" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=right;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="540.73" y="242.50" width="315.27" height="17.00" as="geometry"/></mxCell><mxCell id="b71" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#FBF9FE;strokeColor=#8F76C2;strokeWidth=1.3;fontFamily=Comic Sans MS;fontSize=13;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="6.00" y="280.00" width="520.00" height="242.00" as="geometry"/></mxCell><mxCell id="g72" value="2" style="ellipse;html=1;fillColor=#8F76C2;strokeColor=none;fontFamily=Comic Sans MS;fontSize=11.5;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="19.00" y="291.00" width="18.00" height="18.00" as="geometry"/></mxCell><mxCell id="t73" value="When Does the Teacher Take Over?" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=14;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="43.00" y="290.25" width="255.32" height="19.50" as="geometry"/></mxCell><mxCell id="t74" value="Reflection Trigger" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=13.5;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="26.00" y="324.56" width="123.43" height="18.88" as="geometry"/></mxCell><mxCell id="t75" value="Teacher’s top-1" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26.00" y="355.19" width="94.29" height="17.62" as="geometry"/></mxCell><mxCell id="b76" value="Wait" style="rounded=1;arcSize=5;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#B8E3AD;strokeColor=#6AAE5C;strokeWidth=1;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="127.74" y="354.00" width="43.33" height="20.00" as="geometry"/></mxCell><mxCell id="t77" value="is a reflection word (one of 45, e.g. Wait, But)" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="179.07" y="355.19" width="273.49" height="17.62" as="geometry"/></mxCell><mxCell id="t78" value="Student’s top-5" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="26.00" y="385.19" width="95.74" height="17.62" as="geometry"/></mxCell><mxCell id="b79" value="So" style="rounded=1;arcSize=5;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#DDEEFB;strokeColor=#5B9BD5;strokeWidth=1;fontFamily=Comic Sans MS;fontSize=12.5;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1">