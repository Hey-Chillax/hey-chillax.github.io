takeover is free." style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20.00" y="239.50" width="589.24" height="17.00" as="geometry"/></mxCell><mxCell id="t68" value="Each takeover writes up to 3 paragraphs (256 tokens), then hands back; the answer ends after the 2nd takeover." style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=#5C5C5C;align=left;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20.00" y="257.50" width="638.42" height="17.00" as="geometry"/></mxCell><mxCell id="b69" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#FBF9FE;strokeColor=#8F76C2;strokeWidth=1.3;fontFamily=Comic Sans MS;fontSize=13;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="6.00" y="298.00" width="708.00" height="232.00" as="geometry"/></mxCell><mxCell id="g70" value="2" style="ellipse;html=1;fillColor=#5B448C;strokeColor=none;fontFamily=Comic Sans MS;fontSize=11.5;fontColor=#FFFFFF;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="20.00" y="309.00" width="18.00" height="18.00" as="geometry"/></mxCell><mxCell id="t71" value="When Does the Teacher Take Over?" style="text;html=1;whiteSpace=nowrap;fontFamily=Comic Sans MS;fontSize=14;fontColor=#1E1E1E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45.00" y="308.25" width="255.32" height="19.50" as="geometry"/></mxCell><mxCell id="b72" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;whiteSpace=nowrap;fillColor=#C9B8EA;strokeColor=#8F76C2;strokeWidth=0.9;fontFamily=Comic Sans MS;fontSize=13;fontColor=#1E1E1E;align=center;verticalAlign=middle;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20.00" y="347.00" width="10.00" height="10.00" as="geometry"/></mxCell